<Project>

  <!-- Analysis policy for the whole repository. TreatWarningsAsErrors and
       EnforceCodeStyleInBuild used to be gated on the per-project IsLibrary flag
       (this file is imported AFTER the project body, so that flag — and every
       other property the body sets — is readable here and not in
       Directory.Build.props). They now apply to every project that builds code:
       the entire solution — libraries, CLI, UI, tests, samples, the tools —
       builds with 0 warnings, so they are all held to the same bar.

       Content-only packages are the exception. The five native packages and the
       Bundle meta-package produce no assembly, yet the SDK still runs a compile
       pass with no sources (CS2008) and CA1016 asks for an assembly version on
       an assembly that is never built. TreatWarningsAsErrors turns that noise
       into a build failure for no benefit: there is no code to analyze. They
       are recognised by IncludeBuildOutput=false, set in each of those projects.

       C# analyzer rules (AnalysisLevel=latest-recommended) and the XML doc file
       are still set in Directory.Build.props; projects that opt out of doc
       generation (generator, tests) set GenerateDocumentationFile=false
       themselves.

       StyleCop stays on the libraries only: a formatting opinion rather than a
       correctness rule, and enforcing it on generated Interop or test code buys
       noise, not safety. Note that Roslyn's .editorconfig naming rules are
       IDE-only in practice — the build-time gate for private field naming is
       StyleCop's SA1306, which only the libraries get. -->

  <PropertyGroup Condition="'$(IncludeBuildOutput)' != 'false'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLibrary)' == 'true'">
    <!-- SA1121 (built-in type aliases) started asking for nint in StyleCop 1.3.180,
         which would rewrite every IntPtr in the hand-written wrapper while the
         generated bindings keep IntPtr. The two spellings are the same type; keep
         the one the P/Invoke surface uses. Every other alias rule still applies. -->
    <NoWarn>$(NoWarn);SA1121</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsLibrary)' == 'true'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.180" PrivateAssets="All" />
  </ItemGroup>

  <!-- Link the staged native runtime instead of copying it, on Unix, locally.

       Every output that runs the library stages the same ~65 MiB of natives
       (43 MiB of it the Vulkan backend); measured on this machine, eleven copies
       of libggml-vulkan.so and 148 of the CPU variants were sitting in the tree,
       which is what was left of the build footprint after the platform and
       framework trimming. The bytes are identical, and a hardlink is the same
       file: nothing about what a build produces or loads changes, only how many
       inodes it takes. A later build re-links whichever pin is in use, so a
       FetchNative bump cannot leave an old library behind.

       CI keeps copying: its outputs are ephemeral, and they must be exactly what
       a normal build produces. Windows keeps copying too (link creation there
       needs a different API and the saving is the same only on one volume). -->
  <Target Name="LinkNativeRuntime"
          AfterTargets="CopyNativeLib"
          Condition="'$(CI)' != 'true'
                     and '$(RuntimeIdentifier)' == ''
                     and '$(OutputPath)' != ''
                     and !$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_NativeCanonical
          Include="$(MSBuildThisFileDirectory)native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/libtranscribe.so"
          Condition="!$([MSBuild]::IsOSPlatform('OSX'))" />
      <_NativeCanonical
          Include="$(MSBuildThisFileDirectory)native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/libtranscribe.dylib"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <_NativeCanonical
          Include="$(MSBuildThisFileDirectory)native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/libggml*.so"
          Condition="!$([MSBuild]::IsOSPlatform('OSX'))" />
      <_NativeCanonical
          Include="$(MSBuildThisFileDirectory)native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/libggml*.dylib"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <_NativeStaged Include="@(_NativeCanonical->'$(OutputPath)%(Filename)%(Extension)')" />
    </ItemGroup>
    <!-- Remove first: ln refuses to replace a link that already points at the
         same inode, so a second build would fail without this. -->
    <Delete Files="@(_NativeStaged)" />
    <!-- The transform's second argument is the separator: without it, MSBuild
         joins with ';', and the shell runs every path after the first as its own
         command (a shared library, which dies with SIGSEGV). -->
    <Exec Command="ln @(_NativeCanonical->'&quot;%(FullPath)&quot;', ' ') &quot;$(OutputPath)&quot;"
          Condition="'@(_NativeCanonical)' != ''" />
  </Target>

  <!-- A package must ship every framework it advertises.

       A local Debug build targets net10.0 only (see TranscribeTargetFrameworks),
       so `dotnet pack -c Debug` would produce a package with lib/net10.0 alone
       and no sign in the file that net8.0/net9.0 are missing. Pack defaults to
       Release, which builds all three, but "defaults to" is not a guarantee: a
       pack that would be incomplete fails here instead. Content-only packages
       (IncludeBuildOutput=false) are exempt: they ship no assembly. -->
  <Target Name="RefuseIncompletePack"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true'
                     and '$(IncludeBuildOutput)' != 'false'
                     and '$(TargetFrameworks)' == '$(TranscribeTargetFrameworks)'
                     and '$(TranscribeTargetFrameworks)' != 'net8.0;net9.0;net10.0'">
    <Error Code="TRANS001"
           Text="This pack would ship $(TranscribeTargetFrameworks) only, not every framework the package advertises. Pack in Release (`dotnet pack -c Release`), which builds all of them, or pass -p:TranscribeTargetFrameworks=net8.0;net9.0;net10.0 deliberately." />
  </Target>

  <!-- Keep a local Debug build from carrying every platform's native assets.

       A build without a RuntimeIdentifier copies the whole runtimes/ tree of the
       UI's dependencies (SkiaSharp, HarfBuzzSharp): every OS and architecture,
       including about 320 MiB of Windows .pdb files that are never loaded. On
       this Linux machine that made src/TranscribeCppSharp.UI/bin/Debug 629 MiB,
       of which 356 MiB was the Windows trees and 19 MiB the macOS one. Only the
       host's family is loadable there, so after a Debug build with no RID this
       removes the other families' directories. The host's own assets and the
       native libraries CopyNativeLib.targets places at the output root are
       untouched, and a publish (-r <rid>) keeps the full portable output. -->
  <Target Name="TrimForeignNativeAssets"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'
                     and '$(RuntimeIdentifier)' == ''
                     and '$(CI)' != 'true'
                     and Exists('$(OutDir)runtimes')">
    <ItemGroup>
      <!-- Directory.GetDirectories, not an Include glob: MSBuild globs expand to
           files, and runtimes/ holds only directories, so a glob matched nothing.
           Keep the RID this SDK builds for and drop every other one: SkiaSharp
           and HarfBuzz ship thirteen Linux RIDs (musl, bionic, loongarch64,
           riscv64...), ~180 MiB of files this machine cannot load. Comparing
           the directory name, not a path, keeps it separator-agnostic. -->
      <_NativeRuntimeDirectory Include="$([System.IO.Directory]::GetDirectories('$(OutDir)runtimes'))" />
      <!-- The host's RID and its family fallback (runtimes/osx, runtimes/win)
           stay; every other RID goes. The family is kept because a native
           library can fall back to it when the RID-specific folder is absent. -->
      <_ForeignNativeAsset Include="@(_NativeRuntimeDirectory)"
                           Condition="$([MSBuild]::IsOSPlatform('Linux')) and '%(Filename)' != '$(NETCoreSdkPortableRuntimeIdentifier)' and '%(Filename)' != 'linux'" />
      <_ForeignNativeAsset Include="@(_NativeRuntimeDirectory)"
                           Condition="$([MSBuild]::IsOSPlatform('OSX')) and '%(Filename)' != '$(NETCoreSdkPortableRuntimeIdentifier)' and '%(Filename)' != 'osx'" />
      <_ForeignNativeAsset Include="@(_NativeRuntimeDirectory)"
                           Condition="$([MSBuild]::IsOSPlatform('Windows')) and '%(Filename)' != '$(NETCoreSdkPortableRuntimeIdentifier)' and '%(Filename)' != 'win'" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignNativeAsset)" />
  </Target>

</Project>
