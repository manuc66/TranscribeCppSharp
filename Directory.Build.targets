<Project>

  <!-- Analysis policy for the whole repository. TreatWarningsAsErrors and
       EnforceCodeStyleInBuild used to be gated on the per-project IsLibrary flag
       (this file is imported AFTER the project body, so that flag — and every
       other property the body sets — is readable here and not in
       Directory.Build.props). They now apply to every project that builds code:
       the entire solution — libraries, CLI, UI, tests, samples, the tools —
       builds with 0 warnings, so they are all held to the same bar.

       Content-only packages are the exception. The five native packages and the
       Bundle meta-package produce no assembly, yet the SDK still runs a compile
       pass with no sources (CS2008) and CA1016 asks for an assembly version on
       an assembly that is never built. TreatWarningsAsErrors turns that noise
       into a build failure for no benefit: there is no code to analyze. They
       are recognised by IncludeBuildOutput=false, set in each of those projects.

       C# analyzer rules (AnalysisLevel=latest-recommended) and the XML doc file
       are still set in Directory.Build.props; projects that opt out of doc
       generation (generator, tests) set GenerateDocumentationFile=false
       themselves.

       StyleCop stays on the libraries only: a formatting opinion rather than a
       correctness rule, and enforcing it on generated Interop or test code buys
       noise, not safety. Note that Roslyn's .editorconfig naming rules are
       IDE-only in practice — the build-time gate for private field naming is
       StyleCop's SA1306, which only the libraries get. -->

  <PropertyGroup Condition="'$(IncludeBuildOutput)' != 'false'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsLibrary)' == 'true'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
  </ItemGroup>

  <!-- Keep a local Debug build from carrying every platform's native assets.

       A build without a RuntimeIdentifier copies the whole runtimes/ tree of the
       UI's dependencies (SkiaSharp, HarfBuzzSharp): every OS and architecture,
       including about 320 MiB of Windows .pdb files that are never loaded. On
       this Linux machine that made src/TranscribeCppSharp.UI/bin/Debug 629 MiB,
       of which 356 MiB was the Windows trees and 19 MiB the macOS one. Only the
       host's family is loadable there, so after a Debug build with no RID this
       removes the other families' directories. The host's own assets and the
       native libraries CopyNativeLib.targets places at the output root are
       untouched, and a publish (-r <rid>) keeps the full portable output. -->
  <Target Name="TrimForeignNativeAssets"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'
                     and '$(RuntimeIdentifier)' == ''
                     and Exists('$(OutDir)runtimes')">
    <ItemGroup>
      <!-- Directory.GetDirectories, not an Include glob: MSBuild globs expand to
           files, and runtimes/ holds only directories, so a glob matched nothing. -->
      <_ForeignNativeAsset Include="$([System.IO.Directory]::GetDirectories('$(OutDir)runtimes', 'win*'))"
                           Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('OSX'))" />
      <_ForeignNativeAsset Include="$([System.IO.Directory]::GetDirectories('$(OutDir)runtimes', 'osx*'))"
                           Condition="$([MSBuild]::IsOSPlatform('Linux')) Or $([MSBuild]::IsOSPlatform('Windows'))" />
      <_ForeignNativeAsset Include="$([System.IO.Directory]::GetDirectories('$(OutDir)runtimes', 'linux*'))"
                           Condition="$([MSBuild]::IsOSPlatform('Windows')) Or $([MSBuild]::IsOSPlatform('OSX'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignNativeAsset)" />
  </Target>

</Project>
