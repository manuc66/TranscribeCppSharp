<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TranscribeVersionFile>$([System.IO.File]::ReadAllText($(MSBuildThisFileDirectory)build\TRANSCRIBE_VERSION).Trim())</TranscribeVersionFile>
    <WrapperVersionFile>$([System.IO.File]::ReadAllText($(MSBuildThisFileDirectory)build\WRAPPER_VERSION).Trim())</WrapperVersionFile>
    <!-- The upstream version tracks transcribe.cpp; the wrapper has its own SemVer
         version (WRAPPER_VERSION). Native and Interop packages use the upstream
         version so consumers know which ABI they target. -->
    <Version Condition="'$(Version)' == ''">$(TranscribeVersionFile)</Version>

    <!-- Pedantic analysis for every project in the repository.
         TreatWarningsAsErrors / EnforceCodeStyleInBuild live in
         Directory.Build.targets, which is imported after the project body (the
         StyleCop reference there is the only part still gated on IsLibrary).
         AnalysisLevel and the XML doc file are global here because the SDK reads
         them before the project file is imported; projects that opt out of doc
         generation (generator, tests) set GenerateDocumentationFile=false
         themselves. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Language version pinned instead of left to the per-TFM default. The
         wrapper and Interop multi-target net8.0/net9.0/net10.0, and the SDK
         would otherwise compile the same sources as C# 12, 13 and 14
         respectively — making the lowest leg a silent language ceiling for the
         whole repository. At 14.0 the compiler-only features (field, ?.=,
         extension members, params ReadOnlySpan) work on every target, including
         net8.0, while the net8.0 leg still rejects what needs runtime support:
         `allows ref struct` fails with CS9240. So the oldest TFM stays a
         compatibility guard rather than a syntax budget. Bump this deliberately
         with the SDK; `latest` is avoided so a runner update cannot change the
         language under the build. -->
    <LangVersion>14.0</LangVersion>

    <!-- Package metadata -->
    <Authors>manuc66</Authors>
    <Copyright>Copyright (c) 2026 manuc66</Copyright>
    <PackageTags>speech-to-text;transcription;whisper;whispercpp;stt;audio;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/manuc66/TranscribeCppSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/manuc66/TranscribeCppSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- One icon for every package (wrapper, Interop, Bundle, Native.*, CLI).
         It is the project's existing waveform mark packed into a rounded square;
         docs/assets/images/icon.svg is the source, scripts/generate-icons.sh the
         only thing that produces the PNG. NuGet wants a 128x128 PNG at the package
         root, which the None item below places there. -->
    <PackageIcon>icon-128.png</PackageIcon>

    <!-- The native library and its components are authored upstream
         (https://github.com/handy-computer/transcribe.cpp, MIT); this project
         only provides bindings and packaging and claims no credit for them. -->
    <Description>.NET bindings and packaging for transcribe.cpp (speech-to-text). The native library is developed by the transcribe.cpp authors — this package only adds C# bindings and pre-built binaries.</Description>

    <!-- SourceLink: source debugging for consumers -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Deterministic/reproducible builds. Deterministic=true is the SDK default
         but is stated explicitly here; ContinuousIntegrationBuild is what makes the
         PDB embed normalized paths instead of machine-specific absolute ones, which
         is what reproducible-build checks (e.g. nuget.info) rely on. It must be set
         only on CI: on a developer machine the absolute paths let the IDE locate
         the local sources. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' and '$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Symbol packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.*" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/assets/images/icon-128.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
