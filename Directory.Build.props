<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TranscribeVersionFile>$([System.IO.File]::ReadAllText($(MSBuildThisFileDirectory)build\TRANSCRIBE_VERSION).Trim())</TranscribeVersionFile>
    <WrapperVersionFile>$([System.IO.File]::ReadAllText($(MSBuildThisFileDirectory)build\WRAPPER_VERSION).Trim())</WrapperVersionFile>
    <!-- The upstream version tracks transcribe.cpp; the wrapper has its own SemVer
         version (WRAPPER_VERSION). Native and Interop packages use the upstream
         version so consumers know which ABI they target. -->
    <Version Condition="'$(Version)' == ''">$(TranscribeVersionFile)</Version>

    <!-- Pedantic analysis, applied to libraries only via Directory.Build.targets
         (the target file is imported after the project file, so the per-project
         IsLibrary flag is readable there). AnalysisLevel and the XML doc file are
         global here because the SDK reads them before the project file is imported;
         projects that opt out of doc generation (generator, tests) set
         GenerateDocumentationFile=false themselves. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <Authors>manuc66</Authors>
    <Copyright>Copyright (c) 2026 manuc66</Copyright>
    <PackageTags>speech-to-text;transcription;whisper;whispercpp;stt;audio;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/manuc66/TranscribeCppSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/manuc66/TranscribeCppSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- The native library and its components are authored upstream
         (https://github.com/handy-computer/transcribe.cpp, MIT); this project
         only provides bindings and packaging and claims no credit for them. -->
    <Description>Unofficial .NET bindings and packaging for transcribe.cpp (speech-to-text). The native library is developed by the transcribe.cpp authors — this package only adds C# bindings and pre-built binaries.</Description>

    <!-- SourceLink: source debugging for consumers -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Symbol packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.*" PrivateAssets="All" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
