<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The wrapper is plain managed code over P/Invoke and uses no API newer
         than .NET 8, so it also builds for net8.0/net9.0: a consumer still on
         those runtimes gets a usable asset instead of NU1202. The lower targets
         are a compatibility floor, not a support promise — .NET 8 and .NET 9 are
         both out of support (November 2026 and May 2026), .NET 10 is the LTS.
         LangVersion is pinned to 14.0 in Directory.Build.props, so the language
         is not the constraint; the net8.0 leg is only the runtime guard (a
         feature that needs net9+ runtime support, such as `allows ref struct`,
         fails it with CS9240). -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <IsLibrary>true</IsLibrary>
    <PackageId>TranscribeCppSharp</PackageId>
    <!-- The wrapper has its own SemVer version, decoupled from the upstream
         transcribe.cpp version used by the Native/Interop packages. -->
    <Version>$(WrapperVersionFile)</Version>
    <AssemblyVersion>$(WrapperVersionFile)</AssemblyVersion>
    <FileVersion>$(WrapperVersionFile)</FileVersion>
    <!-- Injected by the CI pack job (WrapperPackageVersion=<wrapper prerelease>);
         not a global MSBuild property, so it does not leak into the referenced
         Interop project's package version. -->
    <PackageVersion Condition="'$(WrapperPackageVersion)' != ''">$(WrapperPackageVersion)</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\generated\TranscribeCppSharp.Interop\TranscribeCppSharp.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Owner-only temporary files, shared as source with the server: both write
         audio uploads to the temp directory, and both used to leave them 0644. -->
    <Compile Include="..\Shared\PrivateTempFile.cs" Link="Shared\PrivateTempFile.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Known-model manifest (names -> HuggingFace repo/revision/sha256). Lives
         with ModelStore in the wrapper, not in one front end, so the CLI and the
         GUI read the same catalogue and share one cache layout. -->
    <EmbeddedResource Include="models.json" LogicalName="models.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TranscribeCppSharp.Interop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>

</Project>
