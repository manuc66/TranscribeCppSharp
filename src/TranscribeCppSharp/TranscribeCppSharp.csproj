<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <IsLibrary>true</IsLibrary>
    <PackageId>TranscribeCppSharp</PackageId>
    <!-- The wrapper has its own SemVer version, decoupled from the upstream
         transcribe.cpp version used by the Native/Interop packages. -->
    <Version>$(WrapperVersionFile)</Version>
    <AssemblyVersion>$(WrapperVersionFile)</AssemblyVersion>
    <FileVersion>$(WrapperVersionFile)</FileVersion>
    <!-- Injected by the CI pack job (WrapperPackageVersion=<wrapper prerelease>);
         not a global MSBuild property, so it does not leak into the referenced
         Interop project's package version. -->
    <PackageVersion Condition="'$(WrapperPackageVersion)' != ''">$(WrapperPackageVersion)</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\generated\TranscribeCppSharp.Interop\TranscribeCppSharp.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Known-model manifest (names -> HuggingFace repo/revision/sha256). Lives
         with ModelStore in the wrapper, not in one front end, so the CLI and the
         GUI read the same catalogue and share one cache layout. -->
    <EmbeddedResource Include="models.json" LogicalName="models.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TranscribeCppSharp.Interop.Tests" />
  </ItemGroup>

</Project>
