<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TranscribeCppSharp.Ui.ViewModels"
             x:Class="TranscribeCppSharp.Ui.Views.BatchView"
             x:DataType="vm:BatchViewModel">

  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <!-- Model and language -->
    <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Model" Margin="0,0,0,4"
                   ToolTip.Tip="Which speech-to-text model to run on every file. Downloaded from HuggingFace on first use and cached. The model is loaded once for the whole batch." />
        <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding ModelAlias}" HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="batch-model"
                  AutomationProperties.Name="Model" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <TextBlock Text="Language" Margin="0,0,0,4"
                   ToolTip.Tip="Language code for the decoder, applied to every file. This is the code the model assumes the audio is in. Only Whisper-family models detect the language themselves." />
        <TextBox Text="{Binding Language}"
                 AutomationProperties.AutomationId="batch-language"
                 AutomationProperties.Name="Language" />
      </StackPanel>
    </Grid>

    <!-- File list -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,0,0,8">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
        <Button Content="Add Files..." Command="{Binding AddFilesCommand}"
                AutomationProperties.AutomationId="batch-add-files"
                AutomationProperties.Name="Add files"
                ToolTip.Tip="Add audio files to the queue. A 16 kHz mono 16-bit WAV is read directly; any other format needs ffmpeg installed." />
        <Button Content="Clear" Command="{Binding ClearFilesCommand}" Margin="8,0,0,0"
                AutomationProperties.AutomationId="batch-clear"
                AutomationProperties.Name="Clear files"
                ToolTip.Tip="Empty the queue. Results already produced are kept." />
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding AudioFiles}" Height="120" />
    </Grid>

    <!-- Action buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Process Batch" Command="{Binding ProcessBatchCommand}" IsEnabled="{Binding !IsProcessing}"
              AutomationProperties.AutomationId="batch-run"
              AutomationProperties.Name="Process batch"
              ToolTip.Tip="Transcribe every file in the queue, one after the other." />
      <Button Content="Export Results" Command="{Binding ExportResultsCommand}" IsEnabled="{Binding Results.Count}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="batch-export"
              AutomationProperties.Name="Export results"
              ToolTip.Tip="Write the batch results to a text file." />
    </StackPanel>

    <!-- Progress -->
    <ProgressBar Grid.Row="3" Value="{Binding Progress}" Maximum="1" IsVisible="{Binding IsProcessing}" Margin="0,0,0,8"
                 AutomationProperties.AutomationId="batch-progress"
                 AutomationProperties.Name="Batch progress" />

    <!-- Status -->
    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,0,0,8"
               AutomationProperties.AutomationId="batch-status"
               AutomationProperties.Name="Status" />

    <!-- Results -->
    <DataGrid Grid.Row="5" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
              AutomationProperties.AutomationId="batch-results"
              AutomationProperties.Name="Batch results">
      <DataGrid.Columns>
        <DataGridTextColumn Header="File" Binding="{Binding AudioPath}" Width="*" />
        <DataGridTextColumn Header="Language" Binding="{Binding DetectedLanguage}" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
        <DataGridTextColumn Header="Text" Binding="{Binding FullText}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
