<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TranscribeTargetFrameworks)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsLibrary>true</IsLibrary>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Shared SubtitleWriter is shared source; style gate already applies in front ends. -->
    <NoWarn>$(NoWarn);SA1515;SA1116;SA1118;SA1407</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranscribeCppSharp\TranscribeCppSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared source: heuristic speaker-turn -> transcript join. Not identity. -->
    <Compile Include="..\Shared\SpeakerAssignment.cs" Link="Shared\SpeakerAssignment.cs" />
    <Compile Include="..\Shared\SubtitleWriter.cs" Link="Shared\SubtitleWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- sherpa-onnx provides ONNX speaker embeddings; model weights are NOT bundled.
         Runtime native package for the target RID is selected by the consumer. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

</Project>
