<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TranscribeCppSharp.Cli</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>

    <!-- Distributed as a .NET tool: `dotnet tool install -g TranscribeCppSharp.Cli`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>transcribe</ToolCommandName>
    <PackageId>TranscribeCppSharp.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <!-- A user-facing tool: follows the wrapper's SemVer (not the upstream ABI). -->
    <Version>$(WrapperVersionFile)</Version>

    <!-- RID-specific tool packages: `dotnet tool install` picks the package for
         the user's platform automatically (no RID to specify). `any` is the
         framework-dependent fallback for platforms without a dedicated build.
         RuntimeIdentifiers must be a superset of ToolPackageRuntimeIdentifiers;
         it only drives packaging here (the native is local content, not a
         package, so restore downloads nothing). .NET SDK 10+ required. -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64;osx-x64;any</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64;osx-x64;any</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranscribeCppSharp\TranscribeCppSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DeviceSelection is internal; the tests assert the backend/device
         policy on machines that have no GPU to exercise it on. -->
    <InternalsVisibleTo Include="TranscribeCppSharp.Interop.Tests" />
  </ItemGroup>

  <!-- Embed the native runtime for the RID being packed into the RID-specific
       tool package, taken from native-packages/ (fetched by tools/FetchNative).
       A per-RID PackageReference does NOT work here: NuGet restore evaluates
       PackageReference once with RuntimeIdentifier unset, so RID-conditional
       references are never restored. Content, by contrast, is evaluated during
       each inner pack (which does set RuntimeIdentifier). -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">
    <None Include="$(MSBuildThisFileDirectory)../../native-packages/$(RuntimeIdentifier)/runtimes/$(RuntimeIdentifier)/native/*"
          Exclude="$(MSBuildThisFileDirectory)../../native-packages/$(RuntimeIdentifier)/runtimes/$(RuntimeIdentifier)/native/.done"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The native runtime is copied into the output for local builds by a shared
       target, so this project and the GUI load the same build. See the target for
       why that matters: a mismatched native fails at run time, not build time. -->
  <Import Project="../../build/CopyNativeLib.targets" />

</Project>
