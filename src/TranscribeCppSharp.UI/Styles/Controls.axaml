<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

  <!-- Reusable styles built on the tokens in Tokens.axaml.

       Classes rather than per-control setters: a view writes Classes="hint" and
       gets the shared size, colour and wrapping, and a change here reaches every
       use. The tokens are read with {DynamicResource} because they live in a
       different file (Tokens.axaml), and {StaticResource} only resolves within
       the file it is written in. -->

  <!-- Section heading: names a group of fields. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Field label: the caption above a control. -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Helper text: the muted line under a control. Wraps, because these carry
       the caveats the app is careful about and must not be clipped. -->
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource AppHintBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Warning text, in the theme-aware danger colour rather than a hard-coded
       red that only worked on a light background. -->
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Page heading: the icon badge, the title and the one line that says what
       the tab is for. Presentation only; the text is the view's own. -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.pageDescription">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource AppHintBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="900" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>

  <!-- The badge behind a page's icon. A circle rather than a rectangle so it
       reads as an emblem next to the title, not as another card. -->
  <Style Selector="Border.pageIcon">
    <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.pageIcon materialIcons|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Width" Value="{DynamicResource IconLg}" />
    <Setter Property="Height" Value="{DynamicResource IconLg}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Icons in controls. The size is a token, and the foreground is inherited
       from whatever the icon sits in (a button's or tab's foreground), so a
       disabled or danger control dims or colours its icon with it. -->
  <Style Selector="materialIcons|MaterialIcon">
    <Setter Property="Width" Value="{DynamicResource IconMd}" />
    <Setter Property="Height" Value="{DynamicResource IconMd}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="materialIcons|MaterialIcon.small">
    <Setter Property="Width" Value="{DynamicResource IconSm}" />
    <Setter Property="Height" Value="{DynamicResource IconSm}" />
  </Style>

  <Style Selector="materialIcons|MaterialIcon.tabIcon">
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!-- A button's icon and label on one line. Without this the icon and the text
       are two content items and the button renders only the last one. -->
  <Style Selector="StackPanel.buttonContent">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A card: a panel that groups related controls, with a background and a
       border that hold up in either theme. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
  </Style>

  <!-- The tentative half of the streaming view: same card shape, a background
       that reads as provisional. -->
  <Style Selector="Border.tentative">
    <Setter Property="Background" Value="{DynamicResource AppTentativeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppTentativeBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
  </Style>

  <!-- The one action that starts work on a tab. Fluent's own accent class
       supplies the colour; this only gives it the padding of a primary action
       so it reads as the main button beside the plain ones. -->
  <Style Selector="Button.accent">
    <Setter Property="Padding" Value="16,6" />
  </Style>

  <!-- A destructive action, in the danger colour. -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
  </Style>

</Styles>
