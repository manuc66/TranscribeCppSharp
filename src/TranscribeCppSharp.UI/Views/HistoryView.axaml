<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TranscribeCppSharp.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="TranscribeCppSharp.UI.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <DockPanel Margin="{DynamicResource PagePadding}">
    <!-- What is saved, where, and what it is not. The paragraph keeps the
         automation id the tests already look for. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Border Classes="pageIcon">
        <materialIcons:MaterialIcon Kind="History" />
      </Border>
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="History" />
        <TextBlock Classes="pageDescription"
                   Text="Every finished transcription is saved on this machine, so closing the app does not lose it. A saved run is self-contained: it opens even if the audio file has moved."
                   AutomationProperties.AutomationId="history-intro"
                   AutomationProperties.Name="History introduction" />
      </StackPanel>
    </StackPanel>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Command="{Binding RefreshCommand}"
              AutomationProperties.AutomationId="history-refresh"
              AutomationProperties.Name="Refresh history">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="Refresh" />
          <TextBlock Text="Refresh" />
        </StackPanel>
      </Button>
      <Button Command="{Binding OpenCommand}" IsEnabled="{Binding Entries.Count}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="history-open"
              AutomationProperties.Name="Open saved transcription"
              ToolTip.Tip="Load the selected run into the Transcription tab, where it can be exported again.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="FolderOpen" />
          <TextBlock Text="Open" />
        </StackPanel>
      </Button>
      <Button Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding Entries.Count}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="history-delete"
              AutomationProperties.Name="Delete selected saved transcriptions"
              ToolTip.Tip="Delete the selected rows. One row is deleted at once; several ask first.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="Delete" />
          <TextBlock Text="Delete selected" />
        </StackPanel>
      </Button>
      <Button Command="{Binding DeleteAllCommand}" IsEnabled="{Binding Entries.Count}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="history-delete-all"
              AutomationProperties.Name="Delete every saved transcription"
              ToolTip.Tip="Delete every saved run from this machine. It asks first.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="DeleteSweep" />
          <TextBlock Text="Delete all" />
        </StackPanel>
      </Button>
      <Button Click="OnOpenFolder" Margin="8,0,0,0"
              AutomationProperties.AutomationId="history-open-folder"
              AutomationProperties.Name="Open the history folder"
              ToolTip.Tip="Show the folder that holds the saved runs, in the file manager.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="Folder" />
          <TextBlock Text="Open folder" />
        </StackPanel>
      </Button>
      <TextBlock Text="{Binding HistoryPath}" Classes="hint" VerticalAlignment="Center" Margin="16,0,0,0"
                 AutomationProperties.AutomationId="history-path"
                 AutomationProperties.Name="History folder" />
    </StackPanel>

    <!-- Inline confirmation: the app has no modal dialogs, and a transcript
         cannot be downloaded again. Shown only for a bulk delete. -->
    <Border Grid.Row="1" IsVisible="{Binding IsConfirmingDelete}" Margin="0,0,0,8"
            Padding="12,8" CornerRadius="4"
            Background="{DynamicResource AppTentativeBrush}"
            BorderBrush="{DynamicResource AppTentativeBorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding ConfirmationMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="history-confirm-panel"
                   AutomationProperties.Name="Delete confirmation" />
        <Button Command="{Binding ConfirmDeleteCommand}"
                AutomationProperties.AutomationId="history-confirm"
                AutomationProperties.Name="Confirm deletion">
          <StackPanel Classes="buttonContent">
            <materialIcons:MaterialIcon Kind="Delete" />
            <TextBlock Text="Delete" />
          </StackPanel>
        </Button>
        <Button Command="{Binding CancelDeleteCommand}"
                AutomationProperties.AutomationId="history-cancel"
                AutomationProperties.Name="Cancel deletion">
          <StackPanel Classes="buttonContent">
            <materialIcons:MaterialIcon Kind="Close" />
            <TextBlock Text="Cancel" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
              SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
              AutoGenerateColumns="False" IsReadOnly="True"
              AutomationProperties.AutomationId="history-grid"
              AutomationProperties.Name="Saved transcriptions">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Saved" Binding="{Binding SavedAtDisplay}" />
        <DataGridTextColumn Header="Audio" Binding="{Binding AudioName}" Width="*" />
        <DataGridTextColumn Header="Model" Binding="{Binding ModelAlias}" />
        <DataGridTextColumn Header="Language" Binding="{Binding Language}" />
        <DataGridTextColumn Header="Length" Binding="{Binding DurationDisplay}" />
        <DataGridTextColumn Header="Segments" Binding="{Binding SegmentCount}" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
               AutomationProperties.AutomationId="history-status"
               AutomationProperties.Name="History status" />
    </Grid>
  </DockPanel>
</UserControl>
