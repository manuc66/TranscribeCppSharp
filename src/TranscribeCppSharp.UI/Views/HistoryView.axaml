<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TranscribeCppSharp.UI.ViewModels"
             x:Class="TranscribeCppSharp.UI.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="Auto,Auto,*,Auto">
    <!-- What is saved, where, and what it is not. -->
    <TextBlock Grid.Row="0" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Every finished transcription is saved on this machine, so closing the app does not lose it. A saved run is self-contained: it opens even if the audio file has moved."
               AutomationProperties.AutomationId="history-intro"
               AutomationProperties.Name="History introduction" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Refresh" Command="{Binding RefreshCommand}"
              AutomationProperties.AutomationId="history-refresh"
              AutomationProperties.Name="Refresh history" />
      <Button Content="Open" Command="{Binding OpenCommand}" IsEnabled="{Binding Entries.Count}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="history-open"
              AutomationProperties.Name="Open saved transcription"
              ToolTip.Tip="Load the selected run into the Transcription tab, where it can be exported again." />
      <Button Content="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding Entries.Count}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="history-delete"
              AutomationProperties.Name="Delete saved transcription"
              ToolTip.Tip="Delete the selected entry's file from this machine." />
      <TextBlock Text="{Binding HistoryPath}" Classes="hint" VerticalAlignment="Center" Margin="16,0,0,0"
                 AutomationProperties.AutomationId="history-path"
                 AutomationProperties.Name="History folder" />
    </StackPanel>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
              AutoGenerateColumns="False" IsReadOnly="True"
              AutomationProperties.AutomationId="history-grid"
              AutomationProperties.Name="Saved transcriptions">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Saved" Binding="{Binding SavedAtDisplay}" />
        <DataGridTextColumn Header="Audio" Binding="{Binding AudioName}" Width="*" />
        <DataGridTextColumn Header="Model" Binding="{Binding ModelAlias}" />
        <DataGridTextColumn Header="Language" Binding="{Binding Language}" />
        <DataGridTextColumn Header="Segments" Binding="{Binding SegmentCount}" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
               AutomationProperties.AutomationId="history-status"
               AutomationProperties.Name="History status" />
  </Grid>
</UserControl>
