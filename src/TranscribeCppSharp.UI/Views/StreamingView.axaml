<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TranscribeCppSharp.UI.ViewModels"
             x:Class="TranscribeCppSharp.UI.Views.StreamingView"
             x:DataType="vm:StreamingViewModel">

  <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
    <!-- Model selection -->
    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="Model" Classes="label"
                 ToolTip.Tip="Which speech-to-text model to run. Only downloaded models that can stream are listed — the Models tab filters the catalogue on the 'streaming' capability. A model is downloaded from HuggingFace on first use and cached." />
      <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding ModelAlias}" HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="streaming-model"
                AutomationProperties.Name="Model" />
      <!-- The list holds what is on disk, so it has to say where the rest went. -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
        <TextBlock Grid.Column="0" Text="{Binding ModelPickerHint}" Classes="hint"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="streaming-model-hint"
                   AutomationProperties.Name="Model availability" />
        <Button Grid.Column="1" Content="Get more…" Command="{Binding OpenModelManagerCommand}"
                Padding="8,2" Margin="8,0,0,0"
                AutomationProperties.AutomationId="streaming-get-models"
                AutomationProperties.Name="Get more models"
                ToolTip.Tip="Open the Models tab: browse the catalogue and download a model. A model is fetched on first use and cached." />
      </Grid>
      <TextBlock Text="{Binding CapabilityStatus}" Classes="hint" Margin="0,4,0,0"
                 IsVisible="{Binding CapabilityStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 AutomationProperties.AutomationId="streaming-capability-status"
                 AutomationProperties.Name="Model capabilities status" />
    </StackPanel>

    <!-- Commit policy, stable prefix, and utterance length -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Commit Policy" Classes="label"
                   ToolTip.Tip="When text is moved out of the tentative area and treated as final. Auto lets the model decide. On Finalize commits only when the model says the segment is final, so text appears later but is steadier. Stable Prefix commits as soon as a prefix has stopped changing, so text appears sooner but can be revised if the model changes its mind." />
        <ComboBox ItemsSource="{Binding AvailableCommitPolicies}" SelectedItem="{Binding SelectedCommitPolicy}" HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="streaming-commit-policy"
                  AutomationProperties.Name="Commit policy" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,8,0">
        <TextBlock Text="Stable Prefix Agreement" Classes="label"
                   ToolTip.Tip="How many times a prefix has to stay unchanged before it is committed, used by the Stable Prefix policy. Higher values mean steadier text and later appearance." />
        <NumericUpDown Value="{Binding StablePrefixAgreement}" Minimum="0" Maximum="100" Increment="1"
                       AutomationProperties.AutomationId="streaming-stable-prefix-agreement"
                       AutomationProperties.Name="Stable prefix agreement" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="8,0,0,0">
        <TextBlock Text="Utterance (s)" Classes="label"
                   ToolTip.Tip="How many seconds of audio one streamed utterance may run before the stream is closed and a new one started on the same model. This bounds the memory the native stream holds, which otherwise grows with how long you stream; the cost is that the model loses its audio context across the boundary, and a word split across it can be broken. 0 keeps one utterance for the whole session." />
        <NumericUpDown Value="{Binding UtteranceSeconds}" Minimum="0" Maximum="600" Increment="5"
                       AutomationProperties.AutomationId="streaming-utterance-seconds"
                       AutomationProperties.Name="Utterance seconds" />
      </StackPanel>
    </Grid>

    <!-- Family-specific streaming extensions -->
    <Expander Grid.Row="2" Header="Family extensions" Margin="0,0,0,8"
              IsVisible="{Binding ShowFamilyExtensions}"
              AutomationProperties.AutomationId="streaming-family-extensions"
              AutomationProperties.Name="Family extensions"
              ToolTip.Tip="These are passed only to the model family they belong to; every other family ignores them. Only Moonshine has been measured in this project's benchmark: see docs/streaming-bench.md, which lists what is still unverified.">
      <StackPanel Margin="0,8,0,0" Spacing="4">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="hint" TextWrapping="Wrap"
                     Text="These apply only to the matching model family; other families ignore them. An empty field leaves the extension off, so the model uses its own default." />
          <Button Grid.Column="1" Content="Reset" Command="{Binding ResetExtensionsCommand}"
                  IsEnabled="{Binding HasAnyStreamingExtension}" Padding="8,2" Margin="8,0,0,0"
                  AutomationProperties.AutomationId="streaming-extensions-reset"
                  AutomationProperties.Name="Reset family extensions"
                  ToolTip.Tip="Empty every family-extension field, so no extension is passed and each model uses its own default." />
        </Grid>

        <Grid ColumnDefinitions="*,*" Margin="0,0,0,4" IsVisible="{Binding ShowMoonshineExtensions}">
          <TextBlock Grid.Column="0" Text="Moonshine min decode interval (ms)" VerticalAlignment="Center"
                     ToolTip.Tip="Minimum audio time between partial decodes. Empty (model default) uses the family cadence; 0 decodes on every stable encoder-frame advance; a positive value asks for at least that many milliseconds between decodes, rounded up to a frame. Finalization always decodes. Moonshine is the only streaming family measured in this project: see docs/streaming-bench.md." />
          <NumericUpDown Grid.Column="1" Value="{Binding MoonshineMinDecodeIntervalMs}" Minimum="0" Maximum="5000" Increment="50"
                         PlaceholderText="(model default)"
                         AutomationProperties.AutomationId="streaming-moonshine-interval"
                         AutomationProperties.Name="Moonshine minimum decode interval" />
        </Grid>

        <Grid ColumnDefinitions="*,*" Margin="0,0,0,4" IsVisible="{Binding ShowParakeetExtensions}">
          <TextBlock Grid.Column="0" Text="Parakeet att context right" VerticalAlignment="Center"
                     ToolTip.Tip="Right-context (lookahead) in encoder frames, chosen from the model's trained menu. Empty (model default) picks the first entry, which is max accuracy and max latency; for nemotron-speech-streaming that menu is 13, 6, 1 or 0 frames (1040, 480, 80 or 0 ms). A value outside the menu is rejected by the library." />
          <NumericUpDown Grid.Column="1" Value="{Binding ParakeetAttContextRight}" Minimum="0" Maximum="2000" Increment="10"
                         PlaceholderText="(model default)"
                         AutomationProperties.AutomationId="streaming-parakeet-att-right"
                         AutomationProperties.Name="Parakeet attention context right" />
        </Grid>

        <TextBlock Text="Parakeet buffered (left / chunk / right ms)" FontWeight="SemiBold" Margin="0,4,0,2"
                   IsVisible="{Binding ShowParakeetExtensions}"
                   ToolTip.Tip="Chunked-attention context: how much already-decoded audio to keep on the left, how much to decode per pass, and how much upcoming audio to include on the right. Empty (model default) uses the model's best-accuracy tuple — for parakeet-unified-en-0.6b that is 5600 / 1040 / 1040 ms. A positive value must be an exact multiple of the 80 ms encoder frame; the library never rounds it for you." />
        <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4" IsVisible="{Binding ShowParakeetExtensions}">
          <NumericUpDown Grid.Column="0" Value="{Binding ParakeetLeftMs}" Minimum="0" Maximum="10000" Increment="100" Margin="0,0,4,0"
                         PlaceholderText="(model default)"
                         AutomationProperties.AutomationId="streaming-parakeet-left"
                         AutomationProperties.Name="Parakeet left context"
                         ToolTip.Tip="Milliseconds of already-decoded audio kept as left context. Empty (model default) uses the model's own value." />
          <NumericUpDown Grid.Column="1" Value="{Binding ParakeetChunkMs}" Minimum="0" Maximum="10000" Increment="100" Margin="0,0,4,0"
                         PlaceholderText="(model default)"
                         AutomationProperties.AutomationId="streaming-parakeet-chunk"
                         AutomationProperties.Name="Parakeet chunk size"
                         ToolTip.Tip="Milliseconds of audio decoded per pass. Empty (model default) uses the model's own value." />
          <NumericUpDown Grid.Column="2" Value="{Binding ParakeetRightMs}" Minimum="0" Maximum="10000" Increment="100"
                         PlaceholderText="(model default)"
                         AutomationProperties.AutomationId="streaming-parakeet-right"
                         AutomationProperties.Name="Parakeet right context"
                         ToolTip.Tip="Milliseconds of not-yet-spoken audio included as right context, at the cost of latency. Empty (model default) uses the model's own value." />
        </Grid>

        <Grid ColumnDefinitions="*,*" Margin="0,0,0,4" IsVisible="{Binding ShowVoxtralExtensions}">
          <TextBlock Grid.Column="0" Text="Voxtral delay tokens" VerticalAlignment="Center"
                     ToolTip.Tip="How many delay tokens the realtime stream allows before producing text: more tokens means more lookahead and later text. Empty (model default) is 6 tokens. The validated set is 1 to 15 (80 to 1200 ms) or 30 (2400 ms); anything else is rejected." />
          <NumericUpDown Grid.Column="1" Value="{Binding VoxtralNumDelayTokens}" Minimum="0" Maximum="100" Increment="1"
                         PlaceholderText="(model default)"
                         AutomationProperties.AutomationId="streaming-voxtral-delay-tokens"
                         AutomationProperties.Name="Voxtral delay tokens" />
        </Grid>

        <Grid ColumnDefinitions="*,*" Margin="0,0,0,4" IsVisible="{Binding ShowVoxtralExtensions}">
          <TextBlock Grid.Column="0" Text="Voxtral min decode interval (ms)" VerticalAlignment="Center"
                     ToolTip.Tip="Minimum audio time between tentative decodes while the stream is active. Empty (model default) uses the family cadence; 0 decodes on every feed. Finalization always decodes." />
          <NumericUpDown Grid.Column="1" Value="{Binding VoxtralMinDecodeIntervalMs}" Minimum="0" Maximum="5000" Increment="50"
                         PlaceholderText="(model default)"
                         AutomationProperties.AutomationId="streaming-voxtral-interval"
                         AutomationProperties.Name="Voxtral minimum decode interval" />
        </Grid>
      </StackPanel>
    </Expander>

    <!-- Controls -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Start" Classes="accent" Command="{Binding StartStreamingCommand}" IsEnabled="{Binding CanStartStreaming}"
              AutomationProperties.AutomationId="streaming-start"
              AutomationProperties.Name="Start streaming"
              ToolTip.Tip="Start capturing the microphone and transcribing it live. The first run of a model needs a network connection to download it." />
      <Button Content="Stop" Command="{Binding StopStreamingCommand}" IsEnabled="{Binding IsStreaming}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="streaming-stop"
              AutomationProperties.Name="Stop streaming"
              ToolTip.Tip="Stop capturing and finalize the stream." />
      <Button Content="Clear" Command="{Binding ClearTextCommand}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="streaming-clear"
              AutomationProperties.Name="Clear text"
              ToolTip.Tip="Empty the two text areas. While streaming, only text produced after the click appears again; the model keeps the audio context it already has." />
      <!-- Why Start is disabled when the loaded model says the selected model
           cannot stream. Models upstream records as unable to stream — MOSS, the
           default, among them — are already left out of the picker, so this shows
           when the machine's own answer disagrees with upstream's record. -->
      <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Classes="danger"
                 Text="{Binding StreamingSupportHint}"
                 IsVisible="{Binding StreamingSupportHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 AutomationProperties.AutomationId="streaming-support-hint"
                 AutomationProperties.Name="Streaming support" />
    </StackPanel>

    <!-- Status -->
    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,0,0,8" TextWrapping="Wrap"
               AutomationProperties.AutomationId="streaming-status"
               AutomationProperties.Name="Status" />

    <!-- Committed and tentative text -->
    <Grid Grid.Row="5" ColumnDefinitions="*,*" Margin="0,0,0,8">
      <Border Grid.Column="0" Classes="card" Padding="12" Margin="0,0,4,0">
        <ScrollViewer>
          <SelectableTextBlock Text="{Binding CommittedText}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="streaming-committed-text"
                     AutomationProperties.Name="Committed text" />
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Classes="tentative">
        <ScrollViewer>
          <SelectableTextBlock Text="{Binding TentativeText}" TextWrapping="Wrap" FontStyle="Italic"
                     AutomationProperties.AutomationId="streaming-tentative-text"
                     AutomationProperties.Name="Tentative text" />
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Legend -->
    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="16">
      <TextBlock Text="Left: committed, final." Classes="hint" />
      <TextBlock Text="Right: tentative, may still change." Classes="hint" />
    </StackPanel>
  </Grid>
</UserControl>