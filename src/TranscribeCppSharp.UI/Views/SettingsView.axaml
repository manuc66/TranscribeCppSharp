<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TranscribeCppSharp.UI.ViewModels"
             xmlns:models="using:TranscribeCppSharp.UI.Models"
             xmlns:c="using:TranscribeCppSharp.UI.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="TranscribeCppSharp.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Resources>
    <c:DeviceMemoryConverter x:Key="DeviceMemory" />
  </UserControl.Resources>

  <!-- Every row sizes to its content: with only a handful of compute devices,
       a star row for the grid pushed the About footer to the bottom of the
       viewport and left a screenful of empty space between them. The tab scrolls
       when there are more devices than fit, which is what the list needed. -->
  <DockPanel Margin="{DynamicResource PagePadding}">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Border Classes="pageIcon">
        <materialIcons:MaterialIcon Kind="Cog" />
      </Border>
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="Settings" />
        <TextBlock Classes="pageDescription"
                   Text="Compute backend, cache directory and the devices this build and this machine can see." />
      </StackPanel>
    </StackPanel>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
    <!-- Backend and device -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="Backend" Classes="section"
                     ToolTip.Tip="Which compute backend to run on. Auto uses the GPU when one initializes (every discrete GPU is probed before the integrated ones) and falls back to the CPU otherwise; a forced backend fails instead of falling back." />
          <ComboBox ItemsSource="{Binding BackendOptions}" SelectedItem="{Binding SelectedBackendOption}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="settings-backend"
                    AutomationProperties.Name="Backend">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:BackendOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Text="Device" Classes="section"
                     ToolTip.Tip="Auto lets the backend resolve a device. Pinning one is stricter: it never falls back to another device, so a model that will not fit fails instead of quietly running elsewhere. Choose Auto again to unpin." />
          <ComboBox ItemsSource="{Binding DeviceOptions}"
                    SelectedItem="{Binding SelectedDeviceOption}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="settings-device"
                    AutomationProperties.Name="Device">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:DeviceOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
      <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"
                 Text="Backend and device changes apply to the next run and are remembered for the next launch; there is no Save button."
                 AutomationProperties.AutomationId="settings-apply-note"
                 AutomationProperties.Name="When the compute settings apply" />
      <TextBlock Text="{Binding BackendAvailabilityHint}" Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"
                 AutomationProperties.AutomationId="settings-backend-hint"
                 AutomationProperties.Name="Backend availability" />
      <TextBlock Text="{Binding BackendTargetHint}" Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0"
                 AutomationProperties.AutomationId="settings-backend-target"
                 AutomationProperties.Name="Resolved device and memory" />
    </StackPanel>

    <!-- Cache directory -->
    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="Cache Directory" Classes="section"
                 ToolTip.Tip="Where downloaded models are kept. Shared with the transcribe CLI, so a model downloaded in one is available to the other. The Models tab deletes them." />
      <TextBox Text="{Binding CacheDirectory}" IsReadOnly="True"
               AutomationProperties.AutomationId="settings-cache-directory"
               AutomationProperties.Name="Cache directory" />
    </StackPanel>

    <!-- Backend info -->
    <StackPanel Grid.Row="2" Margin="0,0,0,16">
      <TextBlock Text="Backend Version" Classes="section"
                 ToolTip.Tip="Version of the native transcribe.cpp library the wrapper is bound to." />
      <TextBlock Text="{Binding BackendVersion}"
                 AutomationProperties.AutomationId="settings-backend-version"
                 AutomationProperties.Name="Backend version" />
      <TextBlock Text="{Binding BackendError}" Classes="danger" Margin="0,4,0,0"
                 AutomationProperties.AutomationId="settings-backend-error"
                 AutomationProperties.Name="Backend error"
                 IsVisible="{Binding BackendError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Devices -->
    <StackPanel Grid.Row="3">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
        <TextBlock Grid.Column="0" Text="Available Devices" Classes="section"
                   ToolTip.Tip="Compute devices this build and this machine can see. Free is a live snapshot as of the last refresh; a dash means the device did not report it." />
        <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}"
                AutomationProperties.AutomationId="settings-refresh-devices"
                AutomationProperties.Name="Refresh devices"
                ToolTip.Tip="Re-read the device list and its free-memory figures. The values are a snapshot, not a live monitor.">
          <StackPanel Classes="buttonContent">
            <materialIcons:MaterialIcon Kind="Refresh" />
            <TextBlock Text="Refresh devices" />
          </StackPanel>
        </Button>
      </Grid>
      <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True"
                AutomationProperties.AutomationId="settings-devices"
                AutomationProperties.Name="Available devices">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" />
          <DataGridTextColumn Header="Total" Binding="{Binding MemoryTotal, Converter={StaticResource DeviceMemory}}" />
          <DataGridTextColumn Header="Free" Binding="{Binding MemoryFree, Converter={StaticResource DeviceMemory}}" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>

    <!-- About. Says whose the native work is, which is the one claim this pane
         must not get wrong: the wrapper binds and packages transcribe.cpp, it
         does not implement speech recognition. -->
    <StackPanel Grid.Row="4" Margin="0,16,0,0"
                AutomationProperties.AutomationId="settings-about"
                AutomationProperties.Name="About">
      <TextBlock Text="About" Classes="section" />
      <TextBlock Text="{Binding AppVersion, StringFormat='TranscribeCppSharp {0}'}"
                 AutomationProperties.AutomationId="settings-app-version"
                 AutomationProperties.Name="Application version" />
      <TextBlock Classes="hint" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="MIT-licensed .NET bindings and desktop app. The native speech-to-text library is transcribe.cpp, written by its own authors and used under its own licence; this project binds and packages it and claims no credit for it. Its version is under Backend Version above." />
      <SelectableTextBlock Text="https://github.com/manuc66/TranscribeCppSharp" Margin="0,6,0,0" />
      <SelectableTextBlock Text="https://github.com/handy-computer/transcribe.cpp" />
    </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
