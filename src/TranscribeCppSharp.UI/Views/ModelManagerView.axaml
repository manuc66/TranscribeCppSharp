<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TranscribeCppSharp.UI.ViewModels"
             xmlns:m="using:TranscribeCppSharp.UI.Models"
             xmlns:c="using:TranscribeCppSharp.UI.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="TranscribeCppSharp.UI.Views.ModelManagerView"
             x:DataType="vm:ModelManagerViewModel">

  <UserControl.Resources>
    <c:RowIdConverter x:Key="DownloadId" Prefix="models-download" />
    <c:RowIdConverter x:Key="MeasureId"  Prefix="models-measure" />
    <c:RowIdConverter x:Key="DeleteId"   Prefix="models-delete" />
  </UserControl.Resources>

  <!-- The grid and the detail pane are both stars: they share what is left
       once the fixed rows have taken theirs, so neither can starve the other.
       The pane used to be a fixed 250px Auto row, and a 97px banner plus a
       filter row that wraps after gaining a picker were enough to take the
       whole window and collapse the grid to zero — a master-detail where the
       master disappears when you pick a row. -->
  <Grid Margin="{DynamicResource PagePadding}" RowDefinitions="Auto,Auto,Auto,Auto,*,*,Auto,Auto,Auto">

    <!-- What to look for, and where the weights are -->
    <Border Grid.Row="0" Classes="card" Margin="0,0,0,8"
            ToolTip.Tip="76 models are published by the transcribe.cpp authors. The WER column quotes their headline error rate, with the metric, dataset, split and language in each cell's tooltip. Those figures are useful for narrowing the field, but they mix WER, CER and DER across datasets, so the grid does not rank models by them. Pick on size, licence or that figure, or measure the ones you have on your own audio.">
      <!-- A Grid, not a horizontal StackPanel: the panel measures its child
           against infinite width, so the wrapping TextBlock would never wrap
           and the caveat would be clipped at the window edge. -->
      <Grid ColumnDefinitions="Auto,*">
        <materialIcons:MaterialIcon Grid.Column="0" Classes="small" Kind="InformationOutline"
                                   VerticalAlignment="Top" Margin="0,2,8,0"
                                   Foreground="{DynamicResource AppAccentBrush}" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock TextWrapping="Wrap"
                     Text="Accuracy is quoted from transcribe.cpp's own benchmark, not measured here: the WER column carries their headline error rate, and a cell's tooltip names the metric, dataset, split and language. Those figures mix WER, CER and DER across datasets, so they narrow the field but are not one ranking. For speed, Measure times a model on your audio; docs/streaming-bench.md is this project's only benchmark (Moonshine streaming). A model is fetched on first use and cached." />
          <!-- The tag matches build/TRANSCRIBE_VERSION, the revision the
               shipped catalog was read from. A link to main would show tables
               that can disagree with the figures in this grid. -->
          <HyperlinkButton Classes="link"
                           Content="transcribe.cpp's per-model accuracy tables ↗"
                           NavigateUri="https://github.com/handy-computer/transcribe.cpp/tree/v0.4.1/docs/models"
                           AutomationProperties.Name="Open transcribe.cpp's per-model model docs"
                           ToolTip.Tip="Open the upstream model docs for the pinned transcribe.cpp revision. Each family page carries the published WER tables and the model cards." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Quick filters -->
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <!-- Width of its own: a WrapPanel measures children against infinite width,
           so a star-sized TextBox here would collapse to its padding instead of
           sharing a row. -->
      <TextBox Width="300" Text="{Binding Filter, Mode=TwoWay}"
               PlaceholderText="Search alias, family, repository, licence or language"
               HorizontalAlignment="Stretch"
               AutomationProperties.AutomationId="models-filter"
               AutomationProperties.Name="Filter models"
               ToolTip.Tip="Free-text over the alias, the family read from the repository name, the repository, the licence and the languages the model card declares. Typing a language code searches them the same way the picker below filters on them." />

      <CheckBox Margin="12,0,0,0" VerticalAlignment="Center"
                Content="On disk only"
                IsChecked="{Binding DownloadedOnly}"
                AutomationProperties.AutomationId="models-downloaded-only"
                AutomationProperties.Name="Downloaded models only"
                ToolTip.Tip="Show only the models already downloaded. The fastest way to see what can be used right now without fetching anything." />

      <CheckBox Margin="12,0,0,0" VerticalAlignment="Center"
                Content="Commercial licences only"
                IsChecked="{Binding HideNonCommercial}"
                AutomationProperties.AutomationId="models-commercial-only"
                AutomationProperties.Name="Commercial licences only"
                ToolTip.Tip="Hide the models whose licence forbids commercial use. The flag is a text test on the SPDX identifier in the manifest, so check the licence text itself before relying on it." />

      <!-- SelectedValue, not SelectedItem: the items are ModelSizeFilterOption
           records and the filter is a ModelSizeFilter enum, so SelectedItem never
           matches one and the picker sat blank while doing nothing. SelectedValue
           with a Value binding is what maps item to filter.

           ItemTemplate for the text: the items are records, so with no template the
           box falls back to ToString() and reads 'ModelSizeFilterOption { Value =
           Any, Label = Any size }'. The record's Label is the words meant to be
           read, and the template is what shows them. -->
      <ComboBox Margin="12,0,0,0" MinWidth="130"
                ItemsSource="{Binding SizeFilters}"
                SelectedValueBinding="{Binding Value}"
                SelectedValue="{Binding SizeFilter}"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="models-size-filter"
                AutomationProperties.Name="Size filter"
                ToolTip.Tip="Filter by download size. Smaller models download sooner and use less memory; the manifest ranges from 33 MB to 16 GB.">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="m:ModelSizeFilterOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox Margin="12,0,0,0" MinWidth="150"
                ItemsSource="{Binding Licenses}"
                SelectedItem="{Binding LicenseFilter}"
                PlaceholderText="Any licence"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="models-license-filter"
                AutomationProperties.Name="Licence filter"
                ToolTip.Tip="Filter by licence identifier. 'other' means the manifest does not name a standard licence; check the model card." />

      <ComboBox Margin="12,0,0,0" MinWidth="110"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding LanguageFilter}"
                PlaceholderText="Any language"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="models-language-filter"
                AutomationProperties.Name="Language filter"
                ToolTip.Tip="Show only the models whose model card declares this language. Codes, as the cards state them. A model that declares no languages is hidden while this is set — unknown is not the same as yes." />

      <ComboBox Margin="12,0,0,0" MinWidth="130"
                ItemsSource="{Binding Features}"
                SelectedItem="{Binding FeatureFilter}"
                PlaceholderText="Any capability"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="models-feature-filter"
                AutomationProperties.Name="Capability filter"
                ToolTip.Tip="Show only the models transcribe.cpp records as supporting this capability — streaming, diarize, translate, timestamps, and the rest. The names are theirs, not translated. A model with no record is hidden while this is set, because unknown is not the same as yes." />

      <ComboBox Margin="12,0,0,0" MinWidth="150"
                ItemsSource="{Binding Roles}"
                SelectedItem="{Binding RoleFilter}"
                PlaceholderText="Any role"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="models-role-filter"
                AutomationProperties.Name="Role filter"
                ToolTip.Tip="Show only the models whose role transcribe.cpp records: speech to text, diarization, language identification or speech detection. The loaded model reports its own role; this filter uses the catalog, so it can be used before a download. A model with no record is hidden while this is set, because unknown is not the same as yes.">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="m:ModelRoleOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Command="{Binding ClearFiltersCommand}" Margin="12,0,0,0"
              IsEnabled="{Binding HasAnyQuickFilter}"
              AutomationProperties.AutomationId="models-clear-filters"
              AutomationProperties.Name="Clear filters"
              ToolTip.Tip="Turn every filter off and show the whole catalogue.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="FilterOff" />
          <TextBlock Text="Clear" />
        </StackPanel>
      </Button>
    </WrapPanel>

    <!-- Sort and measure -->
    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
      <Button Content="{Binding NameSortText}" Command="{Binding SortByNameCommand}"
              AutomationProperties.AutomationId="models-sort-name"
              AutomationProperties.Name="Sort by name"
              ToolTip.Tip="Alphabetical order." />

      <Button Margin="8,0,0,0" Content="{Binding SizeSortText}" Command="{Binding SortBySizeCommand}"
              AutomationProperties.AutomationId="models-sort-size"
              AutomationProperties.Name="Sort by size"
              ToolTip.Tip="Smallest download first." />

      <Button Margin="8,0,0,0" Content="{Binding SpeedSortText}" Command="{Binding SortBySpeedCommand}"
              AutomationProperties.AutomationId="models-sort-speed"
              AutomationProperties.Name="Sort by speed"
              ToolTip.Tip="Order by the timing measured on this machine. Click again to reverse it. Models that were never measured cannot be placed in a speed order, so they stay at the bottom in name order." />

      <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Classes="hint"
                 Text="{Binding SortDescription}" />

      <Button Margin="12,0,0,0"
              Command="{Binding PickBenchmarkAudioCommand}"
              AutomationProperties.AutomationId="models-benchmark-audio"
              AutomationProperties.Name="Benchmark audio"
              ToolTip.Tip="Pick the audio the timings are taken over. A measurement is only meaningful for the audio it was measured on, so this is your own file rather than a bundled clip.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="MusicNote" />
          <TextBlock Text="{Binding BenchmarkAudioName, StringFormat='Audio: {0}'}" />
        </StackPanel>
      </Button>

      <NumericUpDown Margin="8,0,0,0" Width="110"
                     Value="{Binding BenchmarkExcerptSeconds}" Minimum="5" Maximum="300" Increment="5"
                     FormatString="0 s"
                     AutomationProperties.AutomationId="models-benchmark-seconds"
                     AutomationProperties.Name="Benchmark excerpt seconds"
                     ToolTip.Tip="How much of the audio each timing run uses. Thirty seconds is a starting point, not a rule: longer is steadier and costs proportionally more time per model." />

      <ComboBox Margin="8,0,0,0" MinWidth="110"
                ItemsSource="{Binding AvailableBenchmarkBackends}"
                SelectedItem="{Binding SelectedBenchmarkBackend}"
                AutomationProperties.AutomationId="models-benchmark-backend"
                AutomationProperties.Name="Benchmark backend"
                ToolTip.Tip="Compute backend for the timing runs. Timings taken on different backends are not comparable, so the backend is recorded with every result." />

      <Button Margin="8,0,0,0"
              Command="{Binding BenchmarkAllCommand}"
              IsEnabled="{Binding !IsBusy}"
              AutomationProperties.AutomationId="models-benchmark-all"
              AutomationProperties.Name="Measure all downloaded models"
              ToolTip.Tip="Time every downloaded model on the chosen audio. Each one is loaded and transcribed three times after a discarded warm-up, so this takes a while for large models. Results are kept for this session only.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="Speedometer" />
          <TextBlock Text="Measure all on disk" />
        </StackPanel>
      </Button>
    </WrapPanel>

    <!-- What the filters are doing, said out loud -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="{Binding ActiveFilterSummary}" Classes="hint"
                 VerticalAlignment="Center" />

      <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Classes="hint"
                 Text="{Binding DownloadedCount, StringFormat='{}{0} downloaded'}" />
      <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Classes="hint"
                 Text="{Binding CacheSizeText, StringFormat='{}{0} on disk'}" />
      <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Classes="hint"
                 Text="{Binding CacheRoot, StringFormat='cached in {0}'}" />
    </Grid>

    <!-- Catalogue -->
    <DataGrid Grid.Row="4" x:Name="ModelsGrid"
              Sorting="OnSorting"
              ItemsSource="{Binding VisibleModels}"
              SelectedItem="{Binding SelectedModel}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal"
              HorizontalAlignment="Stretch"
              Focusable="False"
              HorizontalScrollBarVisibility="Auto"
              AutomationProperties.AutomationId="models-grid"
              AutomationProperties.Name="Model catalogue"
              ToolTip.Tip="Speed, not accuracy. See the Measured line in the detail pane below.">
      <DataGrid.Columns>
        <!-- Alias, with the CLI's default marked on the row.

             The banner above sends the reader to the model marked 'default',
             so the marking has to be on the row itself. IsDefaultModel was
             written for this and bound to nothing, so the banner pointed at a
             mark no one could see. Template rather than a plain text column so
             the alias stays clean and the mark reads as an aside. -->
        <DataGridTemplateColumn Header="Alias" Width="1.6*" Tag="alias" SortMemberPath="Alias">
          <DataTemplate x:DataType="m:ModelCatalogItem">
            <!-- Two lines rather than a separate column: the role is a category
                 that belongs to the model, and a ninth column squeezed the
                 alias, size and licence cells until they truncated. -->
            <StackPanel Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Alias}" />
                <TextBlock Text="default" Opacity="0.7"
                           IsVisible="{Binding IsDefaultModel}"
                           ToolTip.Tip="The alias the transcribe CLI uses when none is given. Not a claim about quality or speed: this project publishes no comparison between the models." />
              </StackPanel>
              <TextBlock Text="{Binding RoleText}" FontSize="11" Opacity="0.7"
                         IsVisible="{Binding IsNonAsrRole}"
                         ToolTip.Tip="{Binding RoleDetail}" />
            </StackPanel>
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="1.3*" Tag="family" SortMemberPath="Family" />
        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="0.6*" Tag="size" SortMemberPath="SizeText" />
        <!-- A yes or a no, so a template rather than a text column: ToolTip will
             not attach to a column, only to a control. -->
        <DataGridTemplateColumn Header="On disk" Width="0.45*" Tag="ondisk" CanUserSort="True">
          <DataTemplate x:DataType="m:ModelCatalogItem">
            <TextBlock Text="{Binding OnDiskText}"
                       ToolTip.Tip="Whether the weights are on this machine, verified against the manifest's sha256. The download size is in the Size column; the total on disk is on the line above the grid." />
          </DataTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Licence" Binding="{Binding License}" Width="0.9*" Tag="licence" SortMemberPath="License" />
        <!-- What the model card says it covers. Compact form only: some models
             declare 99 languages and the detail pane below carries the list. -->
        <DataGridTextColumn Header="Languages" Binding="{Binding LanguagesText}" Width="1.1*" Tag="languages" SortMemberPath="LanguagesText" />
        <!-- Their measurement, not ours: the cell says the figure, the tooltip
             says whose it is, on which benchmark, at which quantization. Template
             rather than a text column so the tooltip is per row rather than one
             caption standing in for seventy-two different figures. -->
        <DataGridTemplateColumn Width="0.6*" CanUserSort="False">
          <DataGridTemplateColumn.Header>
            <TextBlock Text="WER"
                       ToolTip.Tip="Their error rate, not ours, and deliberately not sortable: the 72 figures come from three metrics (65 WER, 6 CER, 1 DER), two datasets and eight languages, so putting them in one order would rank numbers that do not measure the same thing. Hover a cell for which metric, dataset and language that row's figure came from." />
          </DataGridTemplateColumn.Header>
          <DataTemplate x:DataType="m:ModelCatalogItem">
            <TextBlock Text="{Binding WerText}" ToolTip.Tip="{Binding WerDetail}" />
          </DataTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="x realtime" Binding="{Binding MeasuredText}" Width="0.6*" Tag="speed" SortMemberPath="MeasuredText" />
        <DataGridTextColumn Binding="{Binding DiarizationText}" Width="0.7*" Tag="diarization" SortMemberPath="DiarizationText">
          <!-- A TextBlock rather than a string: this column now mixes two sources,
               and a reader has to be told which one they are looking at. -->
          <DataGridTextColumn.Header>
            <TextBlock Text="Diarization"
                       ToolTip.Tip="Asked of the loaded model when it has been checked on this machine; otherwise what transcribe.cpp records for it. The detail pane says which, and says 'unverified' when they have not checked it either." />
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <!-- Fixed, not a share of the row: the three buttons need ~380px, and a
             star share at the default window gives them 140. Star-sizing the
             actions is what put Delete outside the window. A fixed width also
             means the actions stay reachable when the window is narrowed — the
             columns beside them truncate instead, which is visible, unlike a
             button that is simply gone. -->
        <DataGridTemplateColumn Header="Action" Width="390" CanUserSort="False">
          <DataTemplate x:DataType="m:ModelCatalogItem">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- Text only, unlike the toolbar buttons: this column is a fixed
                   390px so the three actions stay reachable at the default window
                   width, and an icon per button pushed Delete past the grid. -->
              <Button Content="{Binding DownloadButtonText}"
                      Command="{Binding $parent[DataGrid].((vm:ModelManagerViewModel)DataContext).DownloadCommand}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding !$parent[DataGrid].((vm:ModelManagerViewModel)DataContext).IsBusy}"
                      AutomationProperties.AutomationId="{Binding Alias, Converter={StaticResource DownloadId}}"
                      AutomationProperties.Name="{Binding Alias, StringFormat='Download {0}'}"
                      ToolTip.Tip="Fetch this model from HuggingFace at the pinned revision. The download is verified against the sha256 in the manifest before it is cached." />
              <!-- The row's own progress, next to the button that started it: the
                   bar at the bottom of the tab is far from the row and, before,
                   was overlapped by the benchmark bar for the whole download. -->
              <ProgressBar Width="80" Minimum="0" Maximum="1" Value="{Binding DownloadProgress}"
                           IsVisible="{Binding IsDownloading}" VerticalAlignment="Center"
                           AutomationProperties.Name="{Binding Alias, StringFormat='Download progress for {0}'}"
                           ToolTip.Tip="How much of this model has been fetched so far." />
              <Button Content="Measure"
                      Command="{Binding $parent[DataGrid].((vm:ModelManagerViewModel)DataContext).BenchmarkCommand}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding IsCached}"
                      AutomationProperties.AutomationId="{Binding Alias, Converter={StaticResource MeasureId}}"
                      AutomationProperties.Name="{Binding Alias, StringFormat='Measure {0}'}"
                      ToolTip.Tip="Load this model and time it on the chosen audio. Three passes after a discarded warm-up; the best is kept, because contention only ever makes a run slower." />
              <Button Content="Delete"
                      Command="{Binding $parent[DataGrid].((vm:ModelManagerViewModel)DataContext).DeleteCommand}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding IsCached}"
                      AutomationProperties.AutomationId="{Binding Alias, Converter={StaticResource DeleteId}}"
                      AutomationProperties.Name="{Binding Alias, StringFormat='Delete {0}'}"
                      ToolTip.Tip="Delete this model from disk. It will be downloaded again the next time it is used." />
            </StackPanel>
          </DataTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Detail of the selected model. Always present, so the space below the grid
         is never an empty half that reads as a broken pane: with nothing selected
         it carries the line that says what to do. -->
    <Border Grid.Row="5"
            Classes="card"
            Margin="0,8,0,0"
            AutomationProperties.AutomationId="models-detail"
            AutomationProperties.Name="Selected model details">
      <Panel>
        <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap"
                   IsVisible="{Binding SelectedModel, Converter={x:Static ObjectConverters.IsNull}}"
                   AutomationProperties.AutomationId="models-detail-hint"
                   AutomationProperties.Name="Model details hint"
                   Text="Select a model in the grid above to see its details here: what transcribe.cpp records, the licence, the languages, the cached path and any timing measured on this machine." />
        <ScrollViewer IsVisible="{Binding SelectedModel, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="2" DataContext="{Binding SelectedModel}">
            <TextBlock Text="{Binding Alias}" FontWeight="Bold" FontSize="15" />
            <TextBlock Text="{Binding Repo}" Opacity="0.8" />
            <TextBlock Text="{Binding RoleDetail}" Opacity="0.8" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="models-role-detail"
                       AutomationProperties.Name="Model role"
                       ToolTip.Tip="The role transcribe.cpp's catalog records for this model. The loaded model reports its own role when it is checked, which is the authority; this line is what is known before a download." />
            <HyperlinkButton Classes="link"
                             Content="Model card and accuracy tables on Hugging Face ↗"
                             NavigateUri="{Binding ModelCardUri}"
                             Margin="0,2,0,2"
                             AutomationProperties.Name="Open the model card on Hugging Face"
                             ToolTip.Tip="Open this model's Hugging Face card. It carries the published WER table per quantization, the language matrix and the upstream model's own evaluation." />
            <TextBlock Text="{Binding Revision, StringFormat='revision {0}'}" Opacity="0.7" FontSize="11" />
            <TextBlock Opacity="0.8" Margin="0,4,0,0"
                       Text="{Binding License, StringFormat='Licence: {0}'}" />
            <TextBlock Opacity="0.8" Text="{Binding LicenseUrl}" TextWrapping="Wrap" />
          <TextBlock Opacity="0.8" Text="{Binding LanguagesDetail}" TextWrapping="Wrap"
                     ToolTip.Tip="From the model card on HuggingFace, not from the model itself: the loaded model is what answers whether it accepts a language, and the manifest only tells you this before you download." />

          <!-- Everything below comes from upstream's own catalog, pinned at the tag
               this project binds. Their records, their measurements, attributed. -->
          <TextBlock Text="{Binding UpstreamDetail}" TextWrapping="Wrap" Margin="0,4,0,0"
                     IsVisible="{Binding UpstreamDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     ToolTip.Tip="Parameter count and checkpoint provenance as transcribe.cpp records them, read from its pinned model catalog." />

          <TextBlock Opacity="0.8" Text="{Binding QuantizationsDetail}" TextWrapping="Wrap"
                     IsVisible="{Binding QuantizationsDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     ToolTip.Tip="Quantizations transcribe.cpp publishes for this model. Only the one this row pins has been downloaded and checksum-verified here; the others are listed as a catalogue, not as something available on disk." />

          <TextBlock Text="{Binding CapabilitiesDetail}" TextWrapping="Wrap"
                     IsVisible="{Binding CapabilitiesDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     ToolTip.Tip="What transcribe.cpp records the model as able to do. 'unverified upstream' means they mark the capability supported but do not claim to have checked it — their distinction, kept." />

          <TextBlock Text="{Binding HeadlineAccuracyDetail}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0"
                     IsVisible="{Binding HeadlineAccuracyDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     AutomationProperties.AutomationId="models-headline-accuracy"
                     AutomationProperties.Name="Upstream accuracy"
                     ToolTip.Tip="Measured by transcribe.cpp on their benchmark, not by this project: useful to narrow the field, but not a measurement of your audio." />
            <TextBlock Opacity="0.8" Text="{Binding SizeText, StringFormat='Download size: {0}'}" />
            <TextBlock Opacity="0.8" Text="{Binding OnDiskText}" />
            <TextBlock Opacity="0.8"
                       Text="{Binding DiarizationDetail, StringFormat='Diarization: {0}'}"
                       TextWrapping="Wrap"
                       ToolTip.Tip="Only known for a model checked on this machine. The manifest declares no capabilities, and the native library only answers once the model is loaded." />
            <TextBlock Opacity="0.8" Text="{Binding LocalPath, StringFormat='Cached at: {0}'}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Sha256, StringFormat='sha256: {0}'}" Opacity="0.6" FontSize="11"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding Benchmark.ConditionsText, StringFormat='Measured: {0}'}"
                       IsVisible="{Binding IsMeasured}" Margin="0,6,0,0" FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       ToolTip.Tip="Speed only. Nothing here knows which model transcribes your speech correctly." />

            <TextBlock Text="Non-commercial licence: check the terms before any commercial use."
                       IsVisible="{Binding IsNonCommercialLicense}"
                       Classes="danger" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>

    <!-- Bulk actions -->
    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Command="{Binding ReloadCommand}"
              AutomationProperties.AutomationId="models-refresh"
              AutomationProperties.Name="Refresh"
              ToolTip.Tip="Re-read the cache, to pick up a model downloaded by the transcribe CLI or added by hand.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="Refresh" />
          <TextBlock Text="Refresh" />
        </StackPanel>
      </Button>
      <Button Command="{Binding CancelDownloadCommand}"
              IsEnabled="{Binding IsDownloading}"
              Margin="8,0,0,0"
              AutomationProperties.AutomationId="models-cancel-download"
              AutomationProperties.Name="Cancel the current download"
              ToolTip.Tip="Stop the download in flight. Its partial file is deleted, so nothing half-written is cached, and the row can be downloaded again later.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="Cancel" />
          <TextBlock Text="Cancel download" />
        </StackPanel>
      </Button>
      <Button Classes="danger"
              Command="{Binding DeleteAllCommand}"
              IsEnabled="{Binding !IsBusy}"
              Margin="8,0,0,0"
              AutomationProperties.AutomationId="models-delete-all"
              AutomationProperties.Name="Delete all downloaded models"
              ToolTip.Tip="Delete every model currently on disk. Only the cached model files are touched.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="DeleteSweep" />
          <TextBlock Text="Delete all downloaded" />
        </StackPanel>
      </Button>
      <Button Command="{Binding CheckDiarizationCommand}"
              IsEnabled="{Binding !IsBusy}"
              Margin="8,0,0,0"
              AutomationProperties.AutomationId="models-check-diarization"
              AutomationProperties.Name="Check diarization for downloaded models"
              ToolTip.Tip="Load every downloaded model once and ask whether it can attribute speakers. The manifest declares no capabilities, so a model not on disk stays unknown (?).">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="AccountVoice" />
          <TextBlock Text="Check diarization" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Progress -->
    <ProgressBar Grid.Row="7" Value="{Binding DownloadProgress}" Maximum="1" Minimum="0"
                 IsVisible="{Binding IsDownloading}" Margin="0,8,0,0" />
    <ProgressBar Grid.Row="7" Value="{Binding BenchmarkProgress}" Maximum="1" Minimum="0"
                 IsVisible="{Binding IsBenchmarking}" IsIndeterminate="False" Margin="0,8,0,0" />

    <!-- Status -->
    <TextBlock Grid.Row="8" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0" />
  </Grid>
</UserControl>