<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TranscribeCppSharp.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="TranscribeCppSharp.UI.Views.BatchView"
             x:DataType="vm:BatchViewModel">

  <DockPanel Margin="{DynamicResource PagePadding}">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Border Classes="pageIcon">
        <materialIcons:MaterialIcon Kind="PlaylistPlay" />
      </Border>
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="Batch" />
        <TextBlock Classes="pageDescription"
                   Text="Transcribe a queue of files with one model, one after the other. Each file is read with the same language and session settings." />
      </StackPanel>
    </StackPanel>

    <!-- The results table takes the leftover height instead of being an Auto row
         pinned under a star-sized spacer: the spacer left the table showing its
         header at the bottom of an empty window, with the rows it is for out of
         reach. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
    <!-- Model and language -->
    <Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,8">
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Model" Classes="label"
                   ToolTip.Tip="Which speech-to-text model to run on every file. Downloaded from HuggingFace on first use and cached. The model is loaded once for the whole batch." />
        <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding ModelAlias}" HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="batch-model"
                  AutomationProperties.Name="Model" />
        <!-- The list holds what is on disk, so it has to say where the rest went. -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
          <TextBlock Grid.Column="0" Text="{Binding ModelPickerHint}" Classes="hint"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="batch-model-hint"
                     AutomationProperties.Name="Model availability" />
          <Button Grid.Column="1" Command="{Binding OpenModelManagerCommand}"
                  Padding="8,2" Margin="8,0,0,0"
                  AutomationProperties.AutomationId="batch-get-models"
                  AutomationProperties.Name="Get more models"
                  ToolTip.Tip="Open the Models tab: browse the catalogue and download a model. A model is fetched on first use and cached.">
            <StackPanel Classes="buttonContent">
              <materialIcons:MaterialIcon Classes="small" Kind="CloudDownloadOutline" />
              <TextBlock Text="Get more…" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <TextBlock Text="Language" Classes="label"
                   ToolTip.Tip="Language code for the decoder, applied to every file. This is the code the model assumes the audio is in. Only Whisper-family models detect the language themselves." />
        <TextBox Text="{Binding Language}"
                 AutomationProperties.AutomationId="batch-language"
                 AutomationProperties.Name="Language" />
      </StackPanel>
    </Grid>

    <!-- File list -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,0,0,8">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
        <Button Command="{Binding AddFilesCommand}"
                AutomationProperties.AutomationId="batch-add-files"
                AutomationProperties.Name="Add files"
                ToolTip.Tip="Add audio files to the queue. A 16 kHz mono 16-bit WAV is read directly; any other format needs ffmpeg installed.">
          <StackPanel Classes="buttonContent">
            <materialIcons:MaterialIcon Kind="FilePlus" />
            <TextBlock Text="Add Files..." />
          </StackPanel>
        </Button>
        <Button Command="{Binding ClearFilesCommand}" Margin="8,0,0,0"
                AutomationProperties.AutomationId="batch-clear"
                AutomationProperties.Name="Clear files"
                ToolTip.Tip="Empty the queue. Results already produced are kept.">
          <StackPanel Classes="buttonContent">
            <materialIcons:MaterialIcon Kind="Eraser" />
            <TextBlock Text="Clear" />
          </StackPanel>
        </Button>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding AudioFiles}" Height="120" />
    </Grid>

    <!-- Action buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Classes="accent" Command="{Binding ProcessBatchCommand}" IsEnabled="{Binding CanProcessBatch}"
              AutomationProperties.AutomationId="batch-run"
              AutomationProperties.Name="Process batch"
              ToolTip.Tip="Transcribe every file in the queue, one after the other.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="Play" />
          <TextBlock Text="Process Batch" />
        </StackPanel>
      </Button>
      <Button Command="{Binding CancelBatchCommand}" IsEnabled="{Binding CanCancelBatch}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="batch-cancel"
              AutomationProperties.Name="Cancel batch"
              ToolTip.Tip="Stop the batch. The file in flight is dropped; the items that already finished stay in the grid.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="Stop" />
          <TextBlock Text="Cancel" />
        </StackPanel>
      </Button>
      <Button Command="{Binding ExportResultsCommand}" IsEnabled="{Binding Results.Count}" Margin="8,0,0,0"
              AutomationProperties.AutomationId="batch-export"
              AutomationProperties.Name="Export results"
              ToolTip.Tip="Write the batch results to a text file.">
        <StackPanel Classes="buttonContent">
          <materialIcons:MaterialIcon Kind="FileExport" />
          <TextBlock Text="Export Results" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- What is running now, and how far through the queue that is. A batch runs
         a whole file in one native call, so the per-file line names the step
         without inventing a fraction inside it; the bar counts finished files. -->
    <Border Grid.Row="3" Classes="card" IsVisible="{Binding IsProcessing}" Margin="0,0,0,8">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding CurrentFileStep}" Classes="label" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="batch-current-file-step"
                   AutomationProperties.Name="Batch current file position" />
        <TextBlock Text="{Binding CurrentFile}" Classes="hint" TextWrapping="Wrap"
                   IsVisible="{Binding CurrentFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   AutomationProperties.AutomationId="batch-current-file"
                   AutomationProperties.Name="Batch current file" />
        <TextBlock Text="{Binding CurrentFileStatus}" Classes="hint" TextWrapping="Wrap"
                   IsVisible="{Binding CurrentFileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   AutomationProperties.AutomationId="batch-current-file-status"
                   AutomationProperties.Name="Batch current file status" />
        <ProgressBar Value="{Binding Progress}" Maximum="1"
                     AutomationProperties.AutomationId="batch-progress"
                     AutomationProperties.Name="Batch progress" />
      </StackPanel>
    </Border>

    <!-- Status -->
    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,0,0,8"
               AutomationProperties.AutomationId="batch-status"
               AutomationProperties.Name="Status" />

    <!-- Results -->
    <DataGrid Grid.Row="5" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
              AutomationProperties.AutomationId="batch-results"
              AutomationProperties.Name="Batch results">
      <DataGrid.Columns>
        <DataGridTextColumn Header="File" Binding="{Binding AudioPath}" Width="*" />
        <DataGridTextColumn Header="Language" Binding="{Binding DetectedLanguage}" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
        <DataGridTextColumn Header="Text" Binding="{Binding FullText}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
