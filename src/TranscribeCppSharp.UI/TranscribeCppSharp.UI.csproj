<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe, not Exe: it is the same executable on Linux/macOS, but on Windows
         it selects the GUI PE subsystem. With Exe the released .exe opens a black
         console window next to the Avalonia window, which a user double-clicking
         the release archive does not expect (it did not show when running from a
         clone through `dotnet run` in a terminal, so it went unnoticed). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>CS1591</NoWarn>
    <!-- A user-facing app: it follows the wrapper's SemVer, not the upstream ABI
         version (same rule as the CLI and the Bundle). It is what the release
         archive is named after, so the file matches the release it came from. -->
    <Version>$(WrapperVersionFile)</Version>
    <!-- The window and .exe icon. Assets/icon.png (an AvaloniaResource, set as the
         Window's Icon in MainWindow.axaml) is what the title bar and taskbar show;
         this .ico is the Windows executable's own icon. Both are generated from
         docs/assets/images/icon.svg by scripts/generate-icons.sh. -->
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\docs\assets\images\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 12.1.3 everywhere except Avalonia.Controls.DataGrid, which
         still ships only 12.1.2 (its latest). The mix is allowed: DataGrid 12.1.2
         asks for Avalonia 12.1.0, which 12.1.3 satisfies, so the DataGrid runs on
         the newer core. Bump every Avalonia package together, across this
         project, tests/TranscribeCppSharp.UI.Tests and samples/UIScreenshot:
         those projects pin their own Avalonia, and moving one alone fails the
         restore of the others with NU1605 (package downgrade).

         Two packages present at 11.2.1 are gone. Avalonia.Diagnostics was removed
         in Avalonia 12; it was referenced here but never used, since nothing in
         this project calls AttachDevTools. And the explicit Tmds.DBus.Protocol pin
         that carried the CVE-2026-39959 fix on Avalonia 11 is no longer needed:
         Avalonia.FreeDesktop 12.1.3 asks for 0.94.1, which is past the fix range. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- DataGrid is a separate package from the core controls. Without it the
         XAML compiler accepts <DataGrid> but the type does not exist at run
         time, and the control renders nothing at all: no rows, no headers, no
         error. Four of the five views use it. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranscribeCppSharp\TranscribeCppSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests drive ApplyCapabilities directly: that is the path where a model
         report rebuilds the option lists while the view is already bound, which is
         the one case a constructor-driven test cannot reach without downloading a
         real model. -->
    <InternalsVisibleTo Include="TranscribeCppSharp.UI.Tests" />
  </ItemGroup>

  <!-- The native runtime for the RID being published, taken from native-packages/
       (fetched by tools/FetchNative). This is what the per-RID release archives
       carry: a self-contained publish sets RuntimeIdentifier, so the shared
       CopyNativeLib target below — which only runs for a local build — would
       otherwise leave the archive without any native. Mirrors the CLI, which
       embeds its native the same way; see TranscribeCppSharp.Cli.csproj for why a
       per-RID PackageReference cannot be used here. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="$(MSBuildThisFileDirectory)../../native-packages/$(RuntimeIdentifier)/runtimes/$(RuntimeIdentifier)/native/**/*"
          Exclude="$(MSBuildThisFileDirectory)../../native-packages/$(RuntimeIdentifier)/runtimes/$(RuntimeIdentifier)/native/.done"
          CopyToOutputDirectory="PreserveNewest"
          Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The release archive is the publish directory zipped by CI, not a NuGet
       package, so it does not get the README/LICENSE that Directory.Build.props
       packs for NuGet. Copy them into the output so a distributed archive carries
       the project's licence. The upstream component licences (ggml, miniz, Silero
       VAD, ...) ride along under licenses/ inside the native package, injected
       recursively above; the native glob must stay recursive for that, a flat
       native/* drops the licenses/ subdirectory. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE"
          CopyToOutputDirectory="PreserveNewest" Link="LICENSE" />
    <None Include="$(MSBuildThisFileDirectory)../../README.md"
          CopyToOutputDirectory="PreserveNewest" Link="README.md" />
  </ItemGroup>

  <!-- Without this the GUI resolved transcribe.cpp through the NuGet package,
       which is older than the checked-in Interop: 90 of the 99 entry points it
       declares are missing from it, transcribe_device_count among them, so every
       device call threw. See build/CopyNativeLib.targets. -->
  <Import Project="../../build/CopyNativeLib.targets" />


  <ItemGroup>
    <!-- Upstream's pinned model catalog and the code that reads it, shared as
         source so there is one implementation and no shared package. The
         resource is a zip rather than their catalog.db: reading SQLite in .NET
         means a native binary, which the wrapper's "ships no native binaries"
         promise forbids. -->
    <EmbeddedResource Include="..\Shared\..\..\catalog\catalog.zip" Link="Assets\catalog.zip" LogicalName="catalog.zip" />
    <Compile Include="..\Shared\UpstreamCatalog.cs" Link="Shared\UpstreamCatalog.cs" />
    <Compile Include="..\Shared\VadWindowing.cs" Link="Shared\VadWindowing.cs" />
  </ItemGroup>
</Project>
