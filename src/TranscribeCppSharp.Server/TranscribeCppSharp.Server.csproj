<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TranscribeCppSharp.Server</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- An executable, like the CLI: no package surface, no published API to
         document. The types are internal; the test project sees them through
         InternalsVisibleTo. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <Version>$(WrapperVersionFile)</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranscribeCppSharp\TranscribeCppSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The subtitle renderer, shared as source with the CLI and the GUI so the
         same transcript produces the same bytes everywhere. -->
    <Compile Include="..\Shared\SubtitleWriter.cs" Link="Shared\SubtitleWriter.cs" />
    <Compile Include="..\Shared\SpeakerAssignment.cs" Link="Shared\SpeakerAssignment.cs" />
    <Compile Include="..\Shared\WindowAdjustment.cs" Link="Shared\WindowAdjustment.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TranscribeCppSharp.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403" />
  </ItemGroup>

  <!-- The same native build the CLI and the UI load. See the target for why
       loading a different one fails at run time rather than at build time. -->
  <Import Project="../../build/CopyNativeLib.targets" />

</Project>
