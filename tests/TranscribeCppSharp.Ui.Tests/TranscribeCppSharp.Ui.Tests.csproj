<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Avalonia.Headless.XUnit 12.1.2 depends on xunit.v3.extensibility.core
         3.2.2, so this suite is xUnit v3, unlike the interop suite which is
         still xUnit v2. The two projects are separate; neither references the
         other. xUnit v3 test assemblies are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The same Avalonia patch the UI is pinned to. 12.1.3 exists but the UI is
       on 12.1.2, so the test host must match it or the visual tree comes from a
       different build than the one under test. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TranscribeCppSharp.Ui\TranscribeCppSharp.Ui.csproj" />
  </ItemGroup>

</Project>
