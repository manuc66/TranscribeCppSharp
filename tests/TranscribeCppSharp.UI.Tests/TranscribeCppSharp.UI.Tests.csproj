<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Avalonia.Headless.XUnit 12.1.3 depends on xunit.v3.extensibility.core
         3.2.2, so this suite is xUnit v3, unlike the interop suite which is
         still xUnit v2. The two projects are separate; neither references the
         other. xUnit v3 test assemblies are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The same Avalonia patch the UI is pinned to: the test host must match it or
       the visual tree comes from a different build than the one under test. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TranscribeCppSharp.UI\TranscribeCppSharp.UI.csproj" />
  </ItemGroup>

  <!-- The role-dispatch tests load real models through the real service, so the
       native runtime has to be in this output directory too, not only in the UI
       project's. See build/CopyNativeLib.targets. -->
  <Import Project="../../build/CopyNativeLib.targets" />

</Project>
