<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <!-- Auto-fetch native libraries if missing -->
  <Target Name="FetchNativeLibs" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildThisFileDirectory)../../native-packages/linux-x64/runtimes/linux-x64/native/.done')">
    <Exec Command="dotnet run --project $(MSBuildThisFileDirectory)../../tools/FetchNative"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true" />
  </Target>

  <!-- Copy native lib to output so dotnet test finds it -->
  <Target Name="CopyNativeLib" AfterTargets="Build">
    <ItemGroup>
      <NativeLib Include="$(MSBuildThisFileDirectory)../../native-packages/linux-x64/runtimes/linux-x64/native/libtranscribe.so" />
      <NativeLib Include="$(MSBuildThisFileDirectory)../../native-packages/linux-x64/runtimes/linux-x64/native/libggml*.so" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeLib)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"
          Condition="@(NativeLib) != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Generator\Generator.csproj" />
    <ProjectReference Include="..\..\generated\TranscribeCppSharp.Interop\TranscribeCppSharp.Interop.csproj" />
    <ProjectReference Include="..\..\src\TranscribeCppSharp\TranscribeCppSharp.csproj" />
  </ItemGroup>

</Project>
