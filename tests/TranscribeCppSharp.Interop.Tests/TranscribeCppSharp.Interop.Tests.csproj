<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <!-- Auto-fetch native libraries if missing (portable: resolves the current
       RID via NETCoreSdkPortableRuntimeIdentifier, e.g. linux-x64 / osx-arm64).
       The ".done" marker records the transcribe.cpp version it was fetched for:
       checking only that it exists kept a pre-bump tree in place after a pin
       move, and the tests then ran against a native the bindings were not
       generated against. -->
  <PropertyGroup>
    <FetchedNativeDir>$(MSBuildThisFileDirectory)../../native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native</FetchedNativeDir>
    <FetchedNativeMarker>$(FetchedNativeDir)/.done</FetchedNativeMarker>
    <FetchedNativeVersion Condition="Exists('$(FetchedNativeMarker)')">$([System.IO.File]::ReadAllText('$(FetchedNativeMarker)').Trim())</FetchedNativeVersion>
  </PropertyGroup>

  <Target Name="FetchNativeLibs" BeforeTargets="BeforeBuild"
          Condition="'$(FetchedNativeVersion)' != 'transcribe.cpp $(TranscribeVersionFile)'">
    <Exec Command="dotnet run --project $(MSBuildThisFileDirectory)../../tools/FetchNative"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true" />
  </Target>

  <!-- Copy native lib to output so dotnet test finds it (portable across
       linux/osx/win; the DllImportResolver also falls back to the NuGet cache). -->
  <Target Name="CopyNativeLib" AfterTargets="Build">
    <ItemGroup>
      <NativeLib Include="$(MSBuildThisFileDirectory)../../native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/libtranscribe.so"
                 Condition="!$([MSBuild]::IsOSPlatform('Windows')) And !$([MSBuild]::IsOSPlatform('OSX'))" />
      <NativeLib Include="$(MSBuildThisFileDirectory)../../native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/libtranscribe.dylib"
                 Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <NativeLib Include="$(MSBuildThisFileDirectory)../../native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/transcribe.dll"
                 Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <NativeLib Include="$(MSBuildThisFileDirectory)../../native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/libggml*.so"
                 Condition="!$([MSBuild]::IsOSPlatform('Windows')) And !$([MSBuild]::IsOSPlatform('OSX'))" />
      <NativeLib Include="$(MSBuildThisFileDirectory)../../native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/libggml*.dylib"
                 Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <NativeLib Include="$(MSBuildThisFileDirectory)../../native-packages/$(NETCoreSdkPortableRuntimeIdentifier)/runtimes/$(NETCoreSdkPortableRuntimeIdentifier)/native/ggml*.dll"
                 Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeLib)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"
          Condition="@(NativeLib) != ''" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Generator\Generator.csproj" />
    <ProjectReference Include="..\..\generated\TranscribeCppSharp.Interop\TranscribeCppSharp.Interop.csproj" />
    <ProjectReference Include="..\..\src\TranscribeCppSharp\TranscribeCppSharp.csproj" />
    <!-- For the CLI's pure backend/device policy (DeviceSelection), which is
         unit tested here because CI has no GPU to exercise it on. -->
    <ProjectReference Include="..\..\src\TranscribeCppSharp.Cli\TranscribeCppSharp.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit only reads this when it is copied next to the test assembly; the
         SDK does not copy a JSON file on its own. maxParallelThreads caps how
         many collections transcribe at once, which is what bounds the suite's
         memory. See the file for the measurement behind the number. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
